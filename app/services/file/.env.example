### GRPC CONFIGURATION
# 50052/3012: the user service holds 50051/3011 during local dev.
GRPC_PORT=:50052
DEBUG_PORT=:3012
SHUTDOWN_TIMEOUT=20s

### DATABASE CONFIGURATION
# Local serve targets the compose Postgres (host port 5433); the compose
# service entry overrides host/port to postgres:5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=mokapay
DB_PASSWORD=mokapay
DB_NAME=files

### OBJECT STORAGE (MinIO locally; leave S3_ENDPOINT empty for real S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mokapay-files
S3_ACCESS_KEY=mokapay
S3_SECRET_KEY=mokapay1234

### UPLOAD POLICY
UPLOAD_URL_TTL=15m
DOWNLOAD_URL_TTL=1h
MAX_FILE_SIZE_BYTES=10485760

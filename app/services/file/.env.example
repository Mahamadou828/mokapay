### GRPC CONFIGURATION
# 50052/3012: the user service holds 50051/3011 during local dev.
GRPC_PORT=:50052
DEBUG_PORT=:3012
SHUTDOWN_TIMEOUT=20s

### DATABASE CONFIGURATION
# Local serve targets the compose Postgres (host port 5433); the compose
# service entry overrides host/port to postgres:5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=mokapay
DB_PASSWORD=mokapay
DB_NAME=files

### OBJECT STORAGE (real S3)
# An empty S3_ENDPOINT selects AWS with virtual-hosted URLs. That matters
# beyond tidiness: presigned URLs are handed to the browser, so the endpoint
# they carry has to be one the browser can resolve — a compose-internal
# host (http://minio:9000) cannot be rewritten client-side without breaking
# the SigV4 signature.
# The bucket needs a CORS rule allowing PUT/GET from the app origins.
# To fall back to compose MinIO: S3_ENDPOINT=http://localhost:9000 with the
# mokapay/mokapay1234 keys and the mokapay-files bucket.
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=mokapay-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=

### UPLOAD POLICY
UPLOAD_URL_TTL=15m
DOWNLOAD_URL_TTL=1h
MAX_FILE_SIZE_BYTES=10485760

### DOWNSTREAM SERVICES (gRPC)
# The upload worker fans events out to payment (proof gating) and user
# (notifications).
USER_GRPC_PORT=localhost:50051
PAYMENT_GRPC_PORT=localhost:50053

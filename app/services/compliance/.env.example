### GRPC CONFIGURATION
# 50054/3014: user holds 50051/3011, file 50052/3012 and payment 50053/3013
# during local dev.
GRPC_PORT=:50054
DEBUG_PORT=:3014
SHUTDOWN_TIMEOUT=20s

### DATABASE CONFIGURATION
# Local serve targets the compose Postgres (host port 5433); the compose
# service entry overrides host/port to postgres:5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=mokapay
DB_PASSWORD=mokapay
DB_NAME=compliance

### AML RULE THRESHOLDS
# Amounts are WHOLE USD (the caller converts from minor units). Defaults are
# the prototype's values — NOT yet validated against real regulatory
# requirements. Ops retune these without a migration or a release.
AML_DAILY_LIMIT_USD=10000
AML_WEEKLY_LIMIT_USD=10000
AML_STRUCTURING_MIN_COUNT=3
AML_SENDER_SPIKE_MULT=5
AML_AGENT_SPIKE_MULT=3
AML_BENEFICIARY_CONCENTRATION_COUNT=10
AML_HOURLY_VELOCITY_COUNT=5
AML_NIGHTTIME_COUNT=3
AML_NEW_ACCOUNT_DAYS=1
AML_NEW_ACCOUNT_VOLUME_USD=500

### RISK SCORING
# Score bands (low < MEDIUM <= medium < HIGH <= high < CRITICAL <= critical)
# and the points one triggered rule contributes, by severity.
AML_RISK_MEDIUM=30
AML_RISK_HIGH=60
AML_RISK_CRITICAL=80
AML_SEVERITY_LOW_PTS=5
AML_SEVERITY_MEDIUM_PTS=15
AML_SEVERITY_HIGH_PTS=35

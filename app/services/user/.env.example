### GRPC CONFIGURATION
GRPC_PORT=:50051
# 3011 so a locally-served gateway (3010) never clashes.
DEBUG_PORT=:3011
SHUTDOWN_TIMEOUT=20s

### DATABASE CONFIGURATION
# Local serve targets the compose Postgres (host port 5433); the compose
# service entry overrides host/port to postgres:5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=mokapay
DB_PASSWORD=mokapay
DB_NAME=users

### REDIS CONFIGURATION (OTP / login rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

### AUTH CONFIGURATION
# HS256 signing secret — never leaves this service (gateway validates via
# AuthService.ValidateToken). Generate a real one outside local dev.
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
OTP_TTL=10m
OTP_MAX_ATTEMPTS=3
OTP_SEND_COOLDOWN=60s
OTP_HOURLY_LIMIT=5

### SEED CONFIGURATION (the one OPS account; see `make user/seed`)
SEED_OPS_PHONE=+243000000000
SEED_OPS_PASSWORD=change-me-ops

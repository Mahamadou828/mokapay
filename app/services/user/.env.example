### GRPC CONFIGURATION
GRPC_PORT=:50051
# 3011 so a locally-served gateway (3010) never clashes.
DEBUG_PORT=:3011
SHUTDOWN_TIMEOUT=20s

### DATABASE CONFIGURATION
# Local serve targets the compose Postgres (host port 5433); the compose
# service entry overrides host/port to postgres:5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=mokapay
DB_PASSWORD=mokapay
DB_NAME=users

### REDIS CONFIGURATION (OTP / login rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

### AUTH CONFIGURATION
# Credentials & sessions live in AWS Cognito — the only secret this service
# keeps is the HMAC pepper for OTP code hashes. Generate a real one outside
# local dev.
OTP_PEPPER=dev-pepper-change-me
OTP_TTL=10m
OTP_MAX_ATTEMPTS=3
OTP_SEND_COOLDOWN=60s
OTP_HOURLY_LIMIT=5

### SMS — OTP delivery
# SMS_PROVIDER picks the live sender: africastalking (default) or twilio.
# Whichever is picked, empty credentials keep every SMS on the logging
# sender; an unknown value aborts startup.
SMS_PROVIDER=africastalking

# --- Africa's Talking ---
# Empty AT_USERNAME or AT_API_KEY = logging sender for everyone: local dev
# needs no credentials and the codes show up in the service logs.
# Set AT_USERNAME=sandbox to hit their sandbox account instead of production.
# The seeded test phones (see `make user/seed`) are always kept on the
# logging sender with the fixed OTP 111111, credentials or not — a real send
# would spend credit on a code the team already knows.
# AT_SENDER_ID is optional; empty uses Africa's Talking's shared sender pool.
# A dedicated alphanumeric sender must be registered and approved with them
# first (out of scope here).
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- Twilio ---
# Empty TWILIO_ACCOUNT_SID or TWILIO_AUTH_TOKEN = logging sender for
# everyone, same fallback as Africa's Talking. The SID/token pair also
# accepts an API Key SID + Secret.
# There is no sandbox URL: Twilio's test credentials (test Account SID +
# test Auth Token, magic TWILIO_FROM=+15005550006) go through the very same
# endpoint and are never delivered.
# Set exactly one of TWILIO_FROM (E.164 number or alphanumeric sender) and
# TWILIO_MESSAGING_SERVICE_SID (an "MG…" sender pool, preferred in
# production) — both set, or neither, fails at startup.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

### SMTP — OTP delivery for accounts that picked the email method
# Empty SMTP_HOST = logging sender for everyone: local dev and CI need no
# mail server and the codes show up in the service logs. Port 465 is
# implicit TLS; any other port negotiates STARTTLS opportunistically.
# SMTP_USER/SMTP_PASSWORD may stay empty for an internal relay that accepts
# unauthenticated submissions.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@mokapay.app

### COGNITO CONFIGURATION
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_POOL_ID=
COGNITO_REGION=eu-west-1

### SEED CONFIGURATION (the one OPS account row; its Cognito user is
### provisioned separately — see `make user/seed`)
SEED_OPS_PHONE=+243000000000

### WEB PUSH (VAPID) — empty keys = logging sender (no real push in dev)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBSCRIBER=
PUSH_TTL=30s

### AGENT ENROLLMENT
# Current terms-of-service version; accepts carrying another one are rejected.
TOS_VERSION=1.0

### DOWNSTREAM SERVICES (gRPC)
# Enrollment guarantee/profile calls go to the payment service.
PAYMENT_GRPC_PORT=localhost:50053

### GRPC CONFIGURATION
# 50053/3013: user holds 50051/3011 and file 50052/3012 during local dev.
GRPC_PORT=:50053
DEBUG_PORT=:3013
SHUTDOWN_TIMEOUT=20s

### DATABASE CONFIGURATION
# Local serve targets the compose Postgres (host port 5433); the compose
# service entry overrides host/port to postgres:5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=mokapay
DB_PASSWORD=mokapay
DB_NAME=payments

### GRPC CONFIGURATION
# 50053/3013: user holds 50051/3011 and file 50052/3012 during local dev.
GRPC_PORT=:50053
DEBUG_PORT=:3013
SHUTDOWN_TIMEOUT=20s

### DATABASE CONFIGURATION
# Local serve targets the compose Postgres (host port 5433); the compose
# service entry overrides host/port to postgres:5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=mokapay
DB_PASSWORD=mokapay
DB_NAME=payments

### DOWNSTREAM SERVICES (gRPC)
# The River notify worker pushes through the user service, which also
# answers the one AML snapshot input payment does not own: when an account
# was opened (account_age_days).
USER_GRPC_PORT=localhost:50051
# The transfer surface reads proofs from the file service.
FILE_GRPC_PORT=localhost:50052
# The AML evaluation job ships its metrics snapshot to compliance. The
# call is fire-and-forget from a River job — a compliance that is down
# costs a retried job, never a blocked transfer.
COMPLIANCE_GRPC_PORT=localhost:50054

### COMPLIANCE
# The market's clock. The night-time structuring window (23:00–05:00) is
# read in this zone, not the server's — an IANA name.
COMPLIANCE_TIMEZONE=Africa/Kinshasa

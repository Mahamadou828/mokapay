### WEB CONFIGURATION
API_HOST=:8086
DEBUG_PORT=:3010
SHUTDOWN_TIMEOUT=20s
REQUEST_TIMEOUT=10s

### CORS CONFIGURATION
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization

### SERVICES CONFIGURATION
# One <SERVICE>_GRPC_PORT entry per downstream gRPC service, e.g.:
# EXAMPLE_GRPC_PORT=localhost:50051

### USER SERVICE (gRPC)
USER_GRPC_PORT=localhost:50051

### PAYMENT SERVICE (gRPC) — transfers, offers, agent profile, ledger
PAYMENT_GRPC_PORT=localhost:50053

### FILE SERVICE (gRPC) — proof uploads (presign / confirm)
FILE_GRPC_PORT=localhost:50052

### COMPLIANCE SERVICE (gRPC) — AML alerts, cases, account risk (ops tier)
COMPLIANCE_GRPC_PORT=localhost:50054

### REDIS (live event bus behind the /v1/ws websocket surface)
# Backend services publish their events here; every gateway replica
# subscribes and pushes to its own connected clients. Unreachable redis
# costs the socket, not the API — clients keep their polling backstop.
REDIS_HOST=localhost
REDIS_PORT=6379

### COGNITO (token validation + secret hash)
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_POOL_ID=
COGNITO_REGION=eu-west-1

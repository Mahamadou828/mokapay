# Gateway request collection (JetBrains HTTP client).
# Select an environment (local / docker) — hosts and test data come from
# http-client.private.env.json (copy the .example next to this file).
# Login/register/refresh capture the tokens into client globals, so the
# authed and ops requests below work without copy-pasting anything.

### Readiness probe
GET {{host}}/v1/readiness

### Liveness probe
GET {{host}}/v1/liveness

###############################################################################
# Auth — public tier
###############################################################################

### Send OTP — register (code is SMS-logged by the user service in local dev)
POST {{host}}/v1/auth/otp
Content-Type: application/json

{
  "phone_number": "{{phone_number}}",
  "purpose": "OTP_PURPOSE_REGISTER"
}

### Send OTP — login
POST {{host}}/v1/auth/otp
Content-Type: application/json

{
  "phone_number": "{{phone_number}}",
  "purpose": "OTP_PURPOSE_LOGIN"
}

### Send OTP — password reset
POST {{host}}/v1/auth/otp
Content-Type: application/json

{
  "phone_number": "{{phone_number}}",
  "purpose": "OTP_PURPOSE_RESET"
}

### Register (needs a fresh REGISTER OTP in {{otp_code}})
POST {{host}}/v1/auth/register
Content-Type: application/json

{
  "phone_number": "{{phone_number}}",
  "code": "{{otp_code}}",
  "password": "{{password}}",
  "first_name": "Test",
  "last_name": "User",
  "preferred_language": "LANGUAGE_FR",
  "email": "test.user@example.com"
}

> {%
  client.global.set("access_token", response.body.access_token);
  client.global.set("refresh_token", response.body.refresh_token);
%}

### Login (needs a fresh LOGIN OTP in {{otp_code}})
POST {{host}}/v1/auth/login
Content-Type: application/json

{
  "phone_number": "{{phone_number}}",
  "password": "{{password}}",
  "code": "{{otp_code}}"
}

> {%
  client.global.set("access_token", response.body.access_token);
  client.global.set("refresh_token", response.body.refresh_token);
%}

### Refresh token (sub = the access token's `sub` claim)
POST {{host}}/v1/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{refresh_token}}",
  "sub": "{{sub}}"
}

> {%
  client.global.set("access_token", response.body.access_token);
%}

### Reset password (needs a fresh RESET OTP in {{otp_code}}) → 204
POST {{host}}/v1/auth/password
Content-Type: application/json

{
  "phone_number": "{{phone_number}}",
  "code": "{{otp_code}}",
  "new_password": "{{password}}"
}

###############################################################################
# Account — authed tier (Bearer token)
###############################################################################

### My account
GET {{host}}/v1/me
Authorization: Bearer {{access_token}}

### Update my account (partial — absent fields keep their value)
PATCH {{host}}/v1/me
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "first_name": "Updated",
  "preferred_language": "LANGUAGE_EN"
}

### Logout everywhere (revokes all refresh tokens) → 204
POST {{host}}/v1/auth/logout
Authorization: Bearer {{access_token}}

###############################################################################
# Notifications — authed tier (vapid-key is public)
###############################################################################

### VAPID public key (public — feed to PushManager.subscribe())
GET {{host}}/v1/push/vapid-key

### My notifications (full inbox, newest first)
GET {{host}}/v1/notifications
Authorization: Bearer {{access_token}}

### My unread notifications only
GET {{host}}/v1/notifications?status=NOTIFICATION_STATUS_UNREAD&limit=20
Authorization: Bearer {{access_token}}

### Mark one notification read (idempotent)
POST {{host}}/v1/notifications/{{notification_id}}/read
Authorization: Bearer {{access_token}}

### Mark everything read → 204
POST {{host}}/v1/notifications/read-all
Authorization: Bearer {{access_token}}

### Register this device for web push (body = PushManager.subscribe() result) → 204
POST {{host}}/v1/push/subscriptions
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "endpoint": "https://push.example.com/reg/manual-test",
  "p256dh": "test-p256dh-key",
  "auth": "test-auth-secret"
}

### Unregister this device → 204
DELETE {{host}}/v1/push/subscriptions
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "endpoint": "https://push.example.com/reg/manual-test"
}

###############################################################################
# Enrollment — candidate side (authed tier)
###############################################################################

### My enrollment (latest, whatever its status)
GET {{host}}/v1/enrollment
Authorization: Bearer {{access_token}}

> {%
  if (response.body.id) { client.global.set("enrollment_id", response.body.id); }
%}

### Accept the agent terms (tos_version must match the backend's TOS_VERSION)
POST {{host}}/v1/enrollment/accept
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "id": "{{enrollment_id}}",
  "tos_version": "1.0"
}

### Decline the invitation (only before accepting)
POST {{host}}/v1/enrollment/decline
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "id": "{{enrollment_id}}"
}

###############################################################################
# Admin — ops tier (Bearer token with ops/admin role)
###############################################################################

### Invite a user to become an agent (role → pending_agent)
POST {{host}}/v1/accounts/{{account_id}}/promote
Authorization: Bearer {{access_token}}

> {%
  if (response.body.id) { client.global.set("enrollment_id", response.body.id); }
%}

### Enrollment dashboard — all
GET {{host}}/v1/enrollments
Authorization: Bearer {{access_token}}

### Enrollment dashboard — the approval worklist (TOS accepted)
GET {{host}}/v1/enrollments?status=ENROLLMENT_STATUS_ACCEPTED
Authorization: Bearer {{access_token}}

### Approve an enrollment (accepted → approved, role → agent)
POST {{host}}/v1/enrollments/{{enrollment_id}}/approve
Authorization: Bearer {{access_token}}

### Cancel an enrollment (invited/accepted → cancelled, role → user)
POST {{host}}/v1/enrollments/{{enrollment_id}}/cancel
Authorization: Bearer {{access_token}}

### Create a back-office account (ADMIN only — ops gets 403; the initial
### password is handed over out-of-band, staffer changes it via the
### normal password flow)
POST {{host}}/v1/accounts
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "phone_number": "+243890000001",
  "password": "ChangeMe-2026!",
  "first_name": "Moka",
  "last_name": "Staff",
  "role": "ACCOUNT_ROLE_OPS"
}

### List accounts
GET {{host}}/v1/accounts
Authorization: Bearer {{access_token}}

### List accounts — filtered (enum names, both filters optional)
GET {{host}}/v1/accounts?role=ACCOUNT_ROLE_USER&status=ACCOUNT_STATUS_ACTIVE&phone_number={{phone_number}}
Authorization: Bearer {{access_token}}

### Get an account
GET {{host}}/v1/accounts/{{account_id}}
Authorization: Bearer {{access_token}}

### Update an account (moderation — SUSPENDED/BANNED revokes refresh tokens)
PATCH {{host}}/v1/accounts/{{account_id}}
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "status": "ACCOUNT_STATUS_SUSPENDED"
}

### Promote an account to ops
PATCH {{host}}/v1/accounts/{{account_id}}
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "role": "ACCOUNT_ROLE_OPS"
}

### Delete an account (soft-delete + Cognito delete) → 204
DELETE {{host}}/v1/accounts/{{account_id}}
Authorization: Bearer {{access_token}}

###############################################################################
# Transfers — client flow (authed tier). Chain: operators → quote → create
# (captures transfer_id) → read/timeline → confirm. Amounts are minor units
# (USD cents, CDF whole francs) as JSON strings.
###############################################################################

### Available operators for the corridor
GET {{host}}/v1/transfers/operators?from=CURRENCY_USD&to=CURRENCY_CDF
Authorization: Bearer {{access_token}}

### Quote — 100 USD → CDF (stateless; rate locks at create)
POST {{host}}/v1/transfers/quote
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "from_currency": "CURRENCY_USD",
  "from_amount": "10000",
  "to_currency": "CURRENCY_CDF"
}

### Quote, reverse direction — "the recipient must get 281,635 CDF, what
### do I send?" (the widget's swap arrows; response covers the target)
POST {{host}}/v1/transfers/quote
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "from_currency": "CURRENCY_USD",
  "to_currency": "CURRENCY_CDF",
  "to_amount": "281635"
}

### Create a transfer (inline recipient — also saves the beneficiary)
POST {{host}}/v1/transfers
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "from_currency": "CURRENCY_USD",
  "from_operator": "OPERATOR_ORANGE_MONEY",
  "from_amount": "10000",
  "to_currency": "CURRENCY_CDF",
  "recipient_name": "Mireille K.",
  "recipient_phone": "+243812345678",
  "recipient_operator": "OPERATOR_ORANGE_MONEY",
  "recipient_city": "Kinshasa",
  "note": "Frais scolaires"
}

> {%
  if (response.body.id) { client.global.set("transfer_id", response.body.id); }
%}

### My transfers (status filter optional)
GET {{host}}/v1/transfers?limit=20
Authorization: Bearer {{access_token}}

### One transfer (owner view — agent payment details once matched)
GET {{host}}/v1/transfers/{{transfer_id}}
Authorization: Bearer {{access_token}}

### Its timeline (C13)
GET {{host}}/v1/transfers/{{transfer_id}}/events
Authorization: Bearer {{access_token}}

### Its proofs — party-scoped: works for the client AND the assigned
### agent (GET /v1/files/{id} stays owner-only)
GET {{host}}/v1/transfers/{{transfer_id}}/files
Authorization: Bearer {{access_token}}

### Confirm receipt (pending_client_confirmation → done, releases the hold)
POST {{host}}/v1/transfers/{{transfer_id}}/confirm
Authorization: Bearer {{access_token}}

### Cancel my transfer (pre-accept only)
POST {{host}}/v1/transfers/{{transfer_id}}/cancel
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "reason": "changed my mind"
}

### My saved recipients
GET {{host}}/v1/beneficiaries
Authorization: Bearer {{access_token}}

### Save a recipient (idempotent on phone — re-adding refreshes details)
POST {{host}}/v1/beneficiaries
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "name": "Marie Kabila",
  "phone": "+243821234567",
  "operator": "OPERATOR_M_PESA",
  "city": "Goma"
}

> {%
  if (response.body.id) { client.global.set("beneficiary_id", response.body.id); }
%}

### Update a saved recipient (partial — absent fields keep their value)
PATCH {{host}}/v1/beneficiaries/{{beneficiary_id}}
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "name": "Marie Kabila-Mwamba",
  "city": "Bukavu"
}

### Delete a saved recipient
DELETE {{host}}/v1/beneficiaries/{{beneficiary_id}}
Authorization: Bearer {{access_token}}

###############################################################################
# Agent — agent tier (Bearer token with agent role)
###############################################################################

### My agent profile (balance / held / available)
GET {{host}}/v1/agent/profile
Authorization: Bearer {{access_token}}

### Official deposit channels (where to send a funding deposit; also
### available to pending agents funding the enrollment guarantee)
GET {{host}}/v1/agent/deposit-channels
Authorization: Bearer {{access_token}}

### My offer inbox (live offers, soonest-expiring first)
GET {{host}}/v1/agent/offers
Authorization: Bearer {{access_token}}

> {%
  if (response.body.offers && response.body.offers.length > 0) {
    client.global.set("offer_id", response.body.offers[0].id);
  }
%}

### Accept the offer (first accept wins — reserves the hold)
POST {{host}}/v1/agent/offers/{{offer_id}}/accept
Authorization: Bearer {{access_token}}

### Decline the offer (out of this transfer for good)
POST {{host}}/v1/agent/offers/{{offer_id}}/decline
Authorization: Bearer {{access_token}}

### My assigned transfers
GET {{host}}/v1/agent/transfers
Authorization: Bearer {{access_token}}

### My wallets
GET {{host}}/v1/agent/wallets
Authorization: Bearer {{access_token}}

### Declare a wallet (one per operator; the accepts_* flags are the
### currency opt-out — at least one must be true)
POST {{host}}/v1/agent/wallets
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "operator": "OPERATOR_ORANGE_MONEY",
  "msisdn": "+243990000001",
  "accepts_usd": true,
  "accepts_cdf": true
}

> {%
  if (response.body.id) { client.global.set("wallet_id", response.body.id); }
%}

### Remove a wallet
DELETE {{host}}/v1/agent/wallets/{{wallet_id}}
Authorization: Bearer {{access_token}}

###############################################################################
# Files — proof uploads (authed tier). Chain: create (captures file_id +
# upload_url) → PUT the bytes to upload_url with the SAME Content-Type →
# confirm → the worker advances the ledger request / transfer.
###############################################################################

### Register an upload (sender proof for a transfer)
POST {{host}}/v1/files
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "purpose": "FILE_PURPOSE_SENDER_PROOF",
  "related_type": "transfer",
  "related_id": "{{transfer_id}}",
  "file_name": "payment-proof.jpg",
  "content_type": "image/jpeg",
  "size_bytes": "12"
}

> {%
  if (response.body.file) { client.global.set("file_id", response.body.file.id); }
  if (response.body.upload_url) { client.global.set("upload_url", response.body.upload_url); }
%}

### PUT the bytes straight to storage (12 bytes to match size_bytes above)
PUT {{upload_url}}
Content-Type: image/jpeg

hello-proof!

### Confirm the upload (verifies + hashes + kicks the proof consumer)
POST {{host}}/v1/files/{{file_id}}/confirm
Authorization: Bearer {{access_token}}

### File metadata + download URL once stored
GET {{host}}/v1/files/{{file_id}}
Authorization: Bearer {{access_token}}

### Files attached to a transfer
GET {{host}}/v1/files?related_type=transfer&related_id={{transfer_id}}
Authorization: Bearer {{access_token}}

### Reject a bad proof (ops)
POST {{host}}/v1/admin/files/{{file_id}}/reject
Authorization: Bearer {{access_token}}

###############################################################################
# Ledger — agent side (agent tier; scope pinned to my own profile)
###############################################################################

### My ledger requests (status/type filters optional)
GET {{host}}/v1/agent/ledger/requests
Authorization: Bearer {{access_token}}

### Request a deposit (funding — then upload the deposit proof)
POST {{host}}/v1/agent/ledger/requests
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "type": "LEDGER_REQUEST_TYPE_FUNDING",
  "amount": "5000"
}

> {%
  if (response.body.id) { client.global.set("ledger_request_id", response.body.id); }
%}

### Request a withdrawal (reserves the amount immediately)
POST {{host}}/v1/agent/ledger/requests
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "type": "LEDGER_REQUEST_TYPE_WITHDRAWAL",
  "amount": "1000"
}

### My statement (settlement lines, newest first)
GET {{host}}/v1/agent/ledger/lines?limit=50
Authorization: Bearer {{access_token}}

###############################################################################
# Payment admin — ops tier
###############################################################################

### Ledger worklist — awaiting approval
GET {{host}}/v1/admin/ledger/requests?status=LEDGER_REQUEST_STATUS_PENDING_ADMIN_APPROVAL
Authorization: Bearer {{access_token}}

### One ledger request
GET {{host}}/v1/admin/ledger/requests/{{ledger_request_id}}
Authorization: Bearer {{access_token}}

### Create a request as ops (funding with the enrollment reference) —
### escape hatch: accepting the TOS opens this automatically now
POST {{host}}/v1/admin/ledger/requests
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "agent_profile_id": "{{agent_profile_id}}",
  "type": "LEDGER_REQUEST_TYPE_FUNDING",
  "amount": "2000",
  "reference_entity_type": "LEDGER_REFERENCE_TYPE_ENROLLMENT",
  "reference_entity_id": "{{enrollment_id}}"
}

### Approve (settle) — request → done, balance moved, one immutable line
POST {{host}}/v1/admin/ledger/requests/{{ledger_request_id}}/approve
Authorization: Bearer {{access_token}}

### Reject (releases an outflow's reservation)
POST {{host}}/v1/admin/ledger/requests/{{ledger_request_id}}/reject
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "reason": "proof unreadable"
}

### An agent's statement (ops view)
GET {{host}}/v1/admin/ledger/lines?agent_profile_id={{agent_profile_id}}&limit=50
Authorization: Bearer {{access_token}}

### Agent profile by account
GET {{host}}/v1/admin/agent-profiles?account_id={{account_id}}
Authorization: Bearer {{access_token}}

> {%
  if (response.body.id) { client.global.set("agent_profile_id", response.body.id); }
%}

### Agent profile by id
GET {{host}}/v1/admin/agent-profiles/{{agent_profile_id}}
Authorization: Bearer {{access_token}}

### Activate / suspend an agent profile (idempotent)
POST {{host}}/v1/admin/agent-profiles/{{agent_profile_id}}/activate
Authorization: Bearer {{access_token}}

### Suspend
POST {{host}}/v1/admin/agent-profiles/{{agent_profile_id}}/suspend
Authorization: Bearer {{access_token}}

### All transfers (ops worklist; status filter optional)
GET {{host}}/v1/admin/transfers?limit=50
Authorization: Bearer {{access_token}}

### Cancel a transfer from any open state (releases the hold if placed)
POST {{host}}/v1/admin/transfers/{{transfer_id}}/cancel
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "reason": "ops intervention"
}

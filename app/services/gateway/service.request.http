# Gateway request collection (JetBrains HTTP client).
# Select an environment (local / docker) — hosts and test data come from
# http-client.private.env.json (copy the .example next to this file).
# Login/register/refresh capture the tokens into client globals, so the
# authed and ops requests below work without copy-pasting anything.

### Readiness probe
GET {{host}}/v1/readiness

### Liveness probe
GET {{host}}/v1/liveness

###############################################################################
# Auth — public tier
###############################################################################

### Send OTP — register (code is SMS-logged by the user service in local dev)
POST {{host}}/v1/auth/otp
Content-Type: application/json

{
  "phone_number": "{{phone_number}}",
  "purpose": "OTP_PURPOSE_REGISTER"
}

### Send OTP — login
POST {{host}}/v1/auth/otp
Content-Type: application/json

{
  "phone_number": "{{phone_number}}",
  "purpose": "OTP_PURPOSE_LOGIN"
}

### Send OTP — password reset
POST {{host}}/v1/auth/otp
Content-Type: application/json

{
  "phone_number": "{{phone_number}}",
  "purpose": "OTP_PURPOSE_RESET"
}

### Register (needs a fresh REGISTER OTP in {{otp_code}})
POST {{host}}/v1/auth/register
Content-Type: application/json

{
  "phone_number": "{{phone_number}}",
  "code": "{{otp_code}}",
  "password": "{{password}}",
  "first_name": "Test",
  "last_name": "User",
  "preferred_language": "LANGUAGE_FR",
  "email": "test.user@example.com"
}

> {%
  client.global.set("access_token", response.body.access_token);
  client.global.set("refresh_token", response.body.refresh_token);
%}

### Login (needs a fresh LOGIN OTP in {{otp_code}})
POST {{host}}/v1/auth/login
Content-Type: application/json

{
  "phone_number": "{{phone_number}}",
  "password": "{{password}}",
  "code": "{{otp_code}}"
}

> {%
  client.global.set("access_token", response.body.access_token);
  client.global.set("refresh_token", response.body.refresh_token);
%}

### Refresh token (sub = the access token's `sub` claim)
POST {{host}}/v1/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{refresh_token}}",
  "sub": "{{sub}}"
}

> {%
  client.global.set("access_token", response.body.access_token);
%}

### Reset password (needs a fresh RESET OTP in {{otp_code}}) → 204
POST {{host}}/v1/auth/password
Content-Type: application/json

{
  "phone_number": "{{phone_number}}",
  "code": "{{otp_code}}",
  "new_password": "{{password}}"
}

###############################################################################
# Account — authed tier (Bearer token)
###############################################################################

### My account
GET {{host}}/v1/me
Authorization: Bearer {{access_token}}

### Update my account (partial — absent fields keep their value)
PATCH {{host}}/v1/me
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "first_name": "Updated",
  "preferred_language": "LANGUAGE_EN"
}

### Logout everywhere (revokes all refresh tokens) → 204
POST {{host}}/v1/auth/logout
Authorization: Bearer {{access_token}}

###############################################################################
# Notifications — authed tier (vapid-key is public)
###############################################################################

### VAPID public key (public — feed to PushManager.subscribe())
GET {{host}}/v1/push/vapid-key

### My notifications (full inbox, newest first)
GET {{host}}/v1/notifications
Authorization: Bearer {{access_token}}

### My unread notifications only
GET {{host}}/v1/notifications?status=NOTIFICATION_STATUS_UNREAD&limit=20
Authorization: Bearer {{access_token}}

### Mark one notification read (idempotent)
POST {{host}}/v1/notifications/{{notification_id}}/read
Authorization: Bearer {{access_token}}

### Mark everything read → 204
POST {{host}}/v1/notifications/read-all
Authorization: Bearer {{access_token}}

### Register this device for web push (body = PushManager.subscribe() result) → 204
POST {{host}}/v1/push/subscriptions
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "endpoint": "https://push.example.com/reg/manual-test",
  "p256dh": "test-p256dh-key",
  "auth": "test-auth-secret"
}

### Unregister this device → 204
DELETE {{host}}/v1/push/subscriptions
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "endpoint": "https://push.example.com/reg/manual-test"
}

###############################################################################
# Enrollment — candidate side (authed tier)
###############################################################################

### My enrollment (latest, whatever its status)
GET {{host}}/v1/enrollment
Authorization: Bearer {{access_token}}

> {%
  if (response.body.id) { client.global.set("enrollment_id", response.body.id); }
%}

### Accept the agent terms (tos_version must match the backend's TOS_VERSION)
POST {{host}}/v1/enrollment/accept
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "id": "{{enrollment_id}}",
  "tos_version": "1.0"
}

### Decline the invitation (only before accepting)
POST {{host}}/v1/enrollment/decline
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "id": "{{enrollment_id}}"
}

###############################################################################
# Admin — ops tier (Bearer token with ops/admin role)
###############################################################################

### Invite a user to become an agent (role → pending_agent)
POST {{host}}/v1/accounts/{{account_id}}/promote
Authorization: Bearer {{access_token}}

> {%
  if (response.body.id) { client.global.set("enrollment_id", response.body.id); }
%}

### Enrollment dashboard — all
GET {{host}}/v1/enrollments
Authorization: Bearer {{access_token}}

### Enrollment dashboard — the approval worklist (TOS accepted)
GET {{host}}/v1/enrollments?status=ENROLLMENT_STATUS_ACCEPTED
Authorization: Bearer {{access_token}}

### Approve an enrollment (accepted → approved, role → agent)
POST {{host}}/v1/enrollments/{{enrollment_id}}/approve
Authorization: Bearer {{access_token}}

### Cancel an enrollment (invited/accepted → cancelled, role → user)
POST {{host}}/v1/enrollments/{{enrollment_id}}/cancel
Authorization: Bearer {{access_token}}

### List accounts
GET {{host}}/v1/accounts
Authorization: Bearer {{access_token}}

### List accounts — filtered (enum names, both filters optional)
GET {{host}}/v1/accounts?role=ACCOUNT_ROLE_USER&status=ACCOUNT_STATUS_ACTIVE&phone_number={{phone_number}}
Authorization: Bearer {{access_token}}

### Get an account
GET {{host}}/v1/accounts/{{account_id}}
Authorization: Bearer {{access_token}}

### Update an account (moderation — SUSPENDED/BANNED revokes refresh tokens)
PATCH {{host}}/v1/accounts/{{account_id}}
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "status": "ACCOUNT_STATUS_SUSPENDED"
}

### Promote an account to ops
PATCH {{host}}/v1/accounts/{{account_id}}
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "role": "ACCOUNT_ROLE_OPS"
}

### Delete an account (soft-delete + Cognito delete) → 204
DELETE {{host}}/v1/accounts/{{account_id}}
Authorization: Bearer {{access_token}}

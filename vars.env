VERSION=0.0.1

# CLUSTER
KIND_CLUSTER=mokapay
NAMESPACE=service-system
BASE_IMAGE_NAME=localhost/mokapay

# APP
GATEWAY_APP=gateway
USER_APP=user
FILE_APP=file

# IMAGES
GATEWAY_IMAGE=${BASE_IMAGE_NAME}/${GATEWAY_APP}:${VERSION}
USER_IMAGE=${BASE_IMAGE_NAME}/${USER_APP}:${VERSION}
FILE_IMAGE=${BASE_IMAGE_NAME}/${FILE_APP}:${VERSION}

# COMPOSE
# Path is relative to the repo root — every make target cd's there before
# calling docker compose. For manual runs: docker compose -f infra/compose/docker-compose.yml …
COMPOSE_FILE=infra/compose/docker-compose.yml
